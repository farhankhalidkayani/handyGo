# Copy to .env (repo root, for seed/CLI use) and to functions/<name>/.env (Appwrite Console
# env vars per function). Never commit the real .env — it's already in .gitignore.

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT=handygo
APPWRITE_API_KEY=***              # server key: databases.read/write, users.read/write — Functions only, never shipped in an app
APPWRITE_DB=handygo

# AI layer (§4) — local Ollama is tier 1 by default
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: set GROQ_API_KEY (and unset OLLAMA_URL) to use Groq's free tier as tier-1 instead
# of a local model — see plan §4.4. Same aiRouter code path either way.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional: self-hosted LibreTranslate instead of LLM-based translation
LIBRETRANSLATE_URL=

# Routing/ETA for routePlanner (public demo server by default — rate-limited, fine for FYP demo)
OSRM_URL=https://router.project-osrm.org
